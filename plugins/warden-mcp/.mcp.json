{
  "mcpServers": {
    "warden": {
      "type": "stdio",
      "command": "sh",
      "args": ["${CLAUDE_PLUGIN_ROOT}/start.sh"],
      "env": {
        "CLAUDE_PLUGIN_OPTION_VAULT_URL": "${user_config.vault_url}",
        "CLAUDE_PLUGIN_OPTION_CLIENT_ID": "${user_config.client_id}",
        "CLAUDE_PLUGIN_OPTION_CLIENT_SECRET": "${user_config.client_secret}",
        "CLAUDE_PLUGIN_OPTION_MASTER_PASSWORD": "${user_config.master_password}",
        "CLAUDE_PLUGIN_OPTION_READ_ONLY": "${user_config.read_only}",
        "CLAUDE_PLUGIN_OPTION_NO_REVEAL": "${user_config.no_reveal}"
      }
    }
  }
}
