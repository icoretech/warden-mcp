{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex", "docker-compose", "github-actions", "npm"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "ignoreTests": false,
  "platformAutomerge": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "rebaseWhen": "conflicted",
  "rangeStrategy": "bump",
  "timezone": "Europe/Rome",
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the local Node.js runtime",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": ["node = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "Track the npm CLI used only for trusted publishing",
      "managerFilePatterns": ["/^\\.github/workflows/release-please\\.yml$/"],
      "matchStrings": ["NPM_PUBLISH_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "npm",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^biome\\.json$/"],
      "matchStrings": [
        "\"\\$schema\"\\s*:\\s*\"https://biomejs\\.dev/schemas/(?<currentValue>[^/]+)/schema\\.json\""
      ],
      "depNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track the Playwright bootstrap image from the npm package version",
      "managerFilePatterns": ["/^Dockerfile\\.bootstrap$/"],
      "matchStrings": [
        "FROM\\s+mcr\\.microsoft\\.com/playwright:v(?<currentValue>\\d+\\.\\d+\\.\\d+)-jammy"
      ],
      "depNameTemplate": "playwright",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm",
      "autoReplaceStringTemplate": "FROM mcr.microsoft.com/playwright:v{{{newValue}}}-jammy"
    }
  ],
  "packageRules": [
    {
      "description": "Keep Biome package and schema updates together",
      "matchManagers": ["npm", "custom.regex"],
      "matchPackageNames": ["@biomejs/biome"],
      "groupName": "biome tooling",
      "groupSlug": "biome-tooling"
    },
    {
      "description": "Group TypeScript-related tooling",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "/^typescript$/",
        "/^tsx$/",
        "/^@types\\/node$/",
        "/^@types\\/express$/"
      ],
      "groupName": "typescript tooling",
      "groupSlug": "typescript-tooling"
    },
    {
      "description": "Keep Playwright package and compose image updates together",
      "matchManagers": ["custom.regex", "npm"],
      "matchPackageNames": ["playwright"],
      "groupName": "playwright tooling",
      "groupSlug": "playwright-tooling"
    },
    {
      "description": "Make Vaultwarden server image updates releasable",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["vaultwarden/server"],
      "semanticCommits": "enabled",
      "semanticCommitType": "fix",
      "commitMessagePrefix": "fix(deps):",
      "commitMessageAction": "update",
      "commitMessageTopic": "vaultwarden/server docker tag",
      "commitMessageExtra": "to {{prettyNewVersion}}"
    },
    {
      "description": "Prevent Docker-only Playwright image updates",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mcr.microsoft.com/playwright"],
      "enabled": false
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Automerge non-major updates after checks pass",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Keep the Node.js engine and local runtime on major 22",
      "matchManagers": ["npm", "custom.regex"],
      "matchPackageNames": ["node"],
      "allowedVersions": ">=22 <23",
      "automerge": false
    },
    {
      "description": "Keep workflow Node.js runtimes on major 22",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/node-versions"],
      "allowedVersions": ">=22 <23",
      "automerge": false
    },
    {
      "description": "Match Node.js type declarations to the runtime major",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node"],
      "allowedVersions": ">=22 <23"
    },
    {
      "description": "Keep the npm engine on the Node.js 22-compatible release line",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["npm"],
      "allowedVersions": ">=10.9.9 <10.10.0",
      "automerge": false
    }
  ]
}
